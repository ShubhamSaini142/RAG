# Copy to .env (in this backend/ folder) and fill in. Never commit the real .env.
# IMPORTANT (Windows): save .env with LF line endings, not CRLF — a trailing
# carriage return can silently corrupt values like passwords / API keys.
# Use 127.0.0.1 (not "localhost") for service hosts: Docker publishes ports on
# IPv4 only, and "localhost" can resolve to IPv6 (::1) first, causing a long
# connection hang on the first request.

# ---- App ----
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Postgres ----
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5438

# ---- Redis (Celery broker/result) ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379

# ---- Qdrant ----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks

# ---- Object storage (MinIO / S3) ----
S3_ENDPOINT_URL=http://127.0.0.1:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1

# ---- OpenAI (initial provider) ----
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
