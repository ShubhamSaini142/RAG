# Copy to .env (in this backend/ folder) and fill in. Never commit the real .env.
# IMPORTANT (Windows): save .env with LF line endings, not CRLF — a trailing
# carriage return can silently corrupt values like passwords / API keys.

# ---- App ----
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Postgres ----
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5438

# ---- Redis (Celery broker/result) ----
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks

# ---- Object storage (MinIO / S3) ----
S3_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1

# ---- OpenAI (initial provider) ----
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
